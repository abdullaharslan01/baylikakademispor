# Sunucuda: alan adı yazılınca Caddy HTTPS sertifikasını otomatik alır
SITE_ADDRESS=alparslanceylansurucukursu.com.tr, www.alparslanceylansurucukursu.com.tr
HTTP_PORT=80
HTTPS_PORT=443
# Cloudflare arkasında: SSL/TLS modu "Full"; sunucu kendi sertifikasını kullanır
CADDY_TLS=tls internal

# Yönetim panelinin gizli adresi (tahmin edilemez olsun; kimseyle paylaşma). /yonetim/ dışarıya 404 döner.
# Üretmek için: echo "/giris-$(openssl rand -hex 6)"
PANEL_YOLU=/giris-degistir-bunu

# Yerelde denemek için:
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443
